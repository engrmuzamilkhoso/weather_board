# Copy this file to `.env.local` and fill in your own keys.
# `.env.local` is git-ignored. Never commit real keys.
#
# NOTE: Every VITE_* variable is embedded in the client bundle at build time,
# so these keys are visible to anyone who opens the deployed app. That is
# unavoidable in a client-only app — use free-tier keys and restrict them
# (RapidAPI lets you rotate keys; OpenWeatherMap keys are free-tier only).

# OpenWeatherMap — https://home.openweathermap.org/api_keys
# Used for current weather (/data/2.5/weather) and the 5-day/3-hour forecast
# (/data/2.5/forecast). Both are available on the free plan.
# If empty or failing, WeatherBoard falls back to Open-Meteo (no key needed).
VITE_OPENWEATHER_API_KEY=

# GeoDB Cities via RapidAPI — https://rapidapi.com/wirefreethought/api/geodb-cities
# Used for city autocomplete. Free plan: 1 request/second.
# If empty or failing, search falls back to Open-Meteo Geocoding (no key needed).
VITE_RAPIDAPI_KEY=
VITE_RAPIDAPI_HOST=wft-geo-db.p.rapidapi.com
